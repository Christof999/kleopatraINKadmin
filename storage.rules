rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'info@soergel-design.de',
          'info@kleopatra-ink.com'
        ];
    }

    // ── Galerie-Uploads (Admin-App: Pfad gallery/...)
    match /gallery/{fileName} {
      // Öffentliche Website: Bilder per URL lesen
      allow read: if true;
      // Nur freigeschaltete Admins dürfen hochladen/ersetzen/löschen.
      allow create, update: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // ── Wanna-dos (Admin-App: Pfad wannados/...)
    match /wannados/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Alles andere: gesperrt
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
