rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Galerie-Uploads (Admin-App: Pfad gallery/...)
    match /gallery/{fileName} {
      // Öffentliche Website: Bilder per URL lesen
      allow read: if true;
      // Nur eingeloggte Nutzer (Firebase Auth) dürfen hochladen/löschen
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Wanna-dos (Admin-App: Pfad wannados/...)
    match /wannados/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Alles andere: gesperrt
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
