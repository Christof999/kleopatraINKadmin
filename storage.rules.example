// Kopie / Referenz — deploybare Datei ist storage.rules (siehe firebase.json).
//
// Voraussetzung für Uploads: In der Admin-App mit einer freigeschalteten
// Admin-E-Mail angemeldet — sonst ist request.auth == null → unauthorized.
//
// Deploy: npx firebase-tools@latest deploy --only storage
// (Projekt muss verlinkt sein: firebase use)

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'info@soergel-design.de',
          'info@kleopatra-ink.com'
        ];
    }

    match /gallery/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /wannados/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
