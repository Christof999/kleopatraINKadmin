{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/admin.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/admin.html"
    }
  ]
}
