# Firebase (Vite) — Kopieren nach `.env` und Werte aus der Firebase Console eintragen.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Instagram (Vercel Serverless) — Long-lived Access Token
IG_ACCESS_TOKEN=

# Flickr (Vercel Serverless) — generieren mit:  npm run flickr:setup
FLICKR_API_KEY=
FLICKR_SHARED_SECRET=
FLICKR_ACCESS_TOKEN=
FLICKR_ACCESS_TOKEN_SECRET=
FLICKR_USER_ID=
FLICKR_STUDIO_NAME=KleopatraINK
FLICKR_ARTIST_NAME=
